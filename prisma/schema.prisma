generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default("default")
  name      String   @default("Web 独立开发者")
  title     String   @default("Full-Stack Developer & Creative Coder")
  bio       String   @default("致力于构建高可用、具美感且充满想象力的现代 Web 与 AI 产品。")
  avatar    String?
  githubUrl String?
  xUrl      String?
  email     String?
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  url         String
  cover       String?
  images      String    @default("[]")
  summary     String
  description String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        Tag[]
  status      String    @default("published") // "published" | "draft"
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  videoUrl    String?
  sourceUrl   String?
  completedAt String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  cover       String?
  tags        String    @default("[]")
  category    String?
  status      String    @default("draft") // "published" | "draft"
  featured    Boolean   @default(false)
  readingTime Int       @default(1)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt(sort: Desc)])
}

model MusicSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  autoplay       Boolean  @default(false)
  loopPlaylist   Boolean  @default(true)
  defaultVolume  Int      @default(35)
  defaultTrackId String?
  tracks         String   @default("[]")
  updatedAt      DateTime @updatedAt
}
