// Keep models identical to ../schema.prisma (local SQLite).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @default("default")
  name      String   @default("Web 独立开发者")
  title     String   @default("Full-Stack Developer & Creative Coder")
  bio       String   @default("致力于构建高可用、具美感且充满想象力的现代 Web 与 AI 产品。")
  avatar    String?
  githubUrl String?
  xUrl      String?
  email     String?
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  url         String
  cover       String?
  images      String    @default("[]")
  summary     String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        Tag[]
  status      String   @default("published")
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  videoUrl    String?
  sourceUrl   String?
  completedAt String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  cover       String?
  tags        String    @default("[]")
  category    String?
  status      String    @default("draft")
  featured    Boolean   @default(false)
  readingTime Int       @default(1)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt(sort: Desc)])
}

model MusicSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  autoplay       Boolean  @default(false)
  loopPlaylist   Boolean  @default(true)
  defaultVolume  Int      @default(35)
  defaultTrackId String?
  tracks         String   @default("[]")
  updatedAt      DateTime @updatedAt
}

model Podcast {
  id          String   @id @default(cuid())
  rssUrl      String   @unique
  title       String
  description String
  author      String?
  cover       String?
  website     String?
  syncedAt    DateTime @default(now())
  episodes    PodcastEpisode[]
}

model PodcastEpisode {
  id          String   @id @default(cuid())
  podcastId   String
  podcast     Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  guid        String
  title       String
  description String
  audioUrl    String
  cover       String?
  duration    Int?
  publishedAt DateTime?
  website     String?
  createdAt   DateTime @default(now())

  @@unique([podcastId, guid])
  @@index([publishedAt])
}
